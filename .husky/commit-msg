#!/bin/sh
# .husky/commit-msg — Conventional Commits enforcer for naija-ads-frontend
set -euo pipefail

MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")

# Strip comment lines and blank lines, take first real line
STRIPPED=$(echo "$MSG" | grep -v '^#' | grep -v '^$' | head -1)

PATTERN='^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\([a-z0-9/\-]+\))?!?: .{3,}'

if ! echo "$STRIPPED" | grep -qE "$PATTERN"; then
  echo ""
  echo "  X COMMIT REJECTED -- message does not follow Conventional Commits."
  echo ""
  echo "  Expected format:"
  echo "    <type>(<optional-scope>): <description>"
  echo ""
  echo "  Allowed types: feat fix docs style refactor perf test chore ci build revert"
  echo ""
  echo "  Examples:"
  echo "    feat(billing): add fund-wallet flow"
  echo "    fix(auth): redirect 401 to login"
  echo "    docs: update contract gap notes"
  echo ""
  echo "  Your message: $STRIPPED"
  echo ""
  exit 1
fi
