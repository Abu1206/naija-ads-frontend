# Copy to .env.local (gitignored). Dummy values only.

# Where the Go API lives. Only used when NEXT_PUBLIC_DATA_SOURCE=live.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Public origin used by /sitemap.xml and /robots.txt. Set to the deployed
# origin in the hosting provider; never commit a real production value here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "mock"  — render fixture data. The default while the backend is undeployed.
# "live"  — call the Go API above. Set this the moment the server is deployed.
#
# Anything other than "live" means mock, so a missing value still boots a
# working app instead of a wall of error states. See ADR 0003.
NEXT_PUBLIC_DATA_SOURCE=mock

# Server-only keys go in the host env, never NEXT_PUBLIC_*:
# SESSION_SECRET=change-me
# BACKEND_INTERNAL_TOKEN=
